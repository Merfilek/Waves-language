// Mathematical constants: Math.Pi, Math.Tau, Math.E, ...
// Import with: import Math/Constants;

public Class Math
{
    static double Pi      = 3.14159265358979323846;
    static double Tau     = 6.28318530717958647692;   // 2 * Pi
    static double HalfPi  = 1.57079632679489661923;
    static double E       = 2.71828182845904523536;
    static double Sqrt2   = 1.41421356237309504880;
    static double Epsilon = 0.00001;                  // for approximately(); not a machine epsilon
}
