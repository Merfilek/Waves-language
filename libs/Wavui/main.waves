// ── UI class wrapping all WavesUI bridge calls ────────────────────────────────

public static Class UI
{
    // Window
    public static func Bool CreateWindow(String title, Int width, Int height)
    {
        return extern("UI_CreateWindow", title, width, height);
    }

    public static func Bool CreateWindowEx(String title, Int width, Int height,
                                            Bool transparent, Bool decorated, Bool vsync)
    {
        return extern("UI_CreateWindowEx", title, width, height, transparent, decorated, vsync);
    }

    public static func SetTitle(String title)    { extern("UI_SetWindowTitle", title); }
    public static func Close()                    { extern("UI_CloseWindow"); }
    public static func Bool Tick()                     { return extern("UI_Tick"); }
    public static func Run()                      { extern("UI_Run"); }
    public static func SetFrameCallback(String cb){ extern("UI_SetFrameCallback", cb); }
    public static func Bool LoadCSS(String path)       { return extern("UI_LoadCSS", path); }
    public static func Int LoadFont(String name, String path) { return extern("UI_LoadFont", name, path); }
    public static func ParseCSS(String css)       { extern("UI_ParseCSS", css); }

    // Widgets
    public static func String CreateWidget(String tag, String id)    { return extern("UI_CreateWidget", tag, id); }
    public static func AddToRoot(String id)             { extern("UI_AddToRoot", id); }
    public static func AddChild(String parent, String child) { extern("UI_AddChild", parent, child); }
    public static func RemoveChild(String parent, String child) { extern("UI_RemoveChild", parent, child); }

    // Properties
    public static func SetText(String id, String text)       { extern("UI_SetText", id, text); }
    public static func String GetText(String id)                     { return extern("UI_GetText", id); }
    public static func SetValue(String id, String val)        { extern("UI_SetValue", id, val); }
    public static func String GetValue(String id)                    { return extern("UI_GetValue", id); }
    public static func SetPlaceholder(String id, String ph)   { extern("UI_SetPlaceholder", id, ph); }
    public static func SetInputType(String id, String type)   { extern("UI_SetInputType", id, type); }
    public static func SetVisible(String id, Bool v)          { extern("UI_SetVisible", id, v); }
    public static func SetDisabled(String id, Bool d)         { extern("UI_SetDisabled", id, d); }
    public static func SetImageSrc(String id, String path)    { extern("UI_SetImageSrc", id, path); }

    // Styling
    public static func SetClass(String id, String cls)        { extern("UI_SetClass", id, cls); }
    public static func AddClass(String id, String cls)        { extern("UI_AddClass", id, cls); }
    public static func RemoveClass(String id, String cls)     { extern("UI_RemoveClass", id, cls); }
    public static func SetStyle(String id, String css)        { extern("UI_SetStyle", id, css); }

    // Events
    public static func On(String id, String event, String cb) { extern("UI_On", id, event, cb); }
    public static func Off(String id, String event)           { extern("UI_Off", id, event); }

    // Queries
    public static func Bool IsHovered(String id)  { return extern("UI_IsHovered", id); }
    public static func Bool IsFocused(String id)  { return extern("UI_IsFocused", id); }
}

