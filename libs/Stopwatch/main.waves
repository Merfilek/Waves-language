public Class Stopwatch
{
    public Long MilliSeconds = 0;
    public Long MicroSeconds = 0;
    public Long Seconds = 0;
    public String Readable = "";

    public func Start()
    {
        extern("Start");
    }

    public func Stop()
    {
        extern("Stop");
        Seconds = extern("DurationSc");
        MilliSeconds = extern("DurationMs");
        MicroSeconds = extern("DurationUs");
        Readable = f"{Seconds}s {MilliSeconds}ms {MicroSeconds}µs";
    }

    public func Reset()
    {
        extern("Reset");
    }
}